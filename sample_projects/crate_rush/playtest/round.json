[
  {"cmd": "log", "message": "Crate Rush: menu -> Meadow Isle -> all crates -> results -> menu"},
  {"cmd": "wait", "frames": 30},
  {"cmd": "expect", "path": "engine:scene", "value": "menu"},
  {"cmd": "expect", "path": "game:state", "value": "menu"},
  {"cmd": "expect", "path": "play_button:visible", "value": true},
  {"cmd": "expect", "path": "engine:locale", "value": "en"},
  {"cmd": "expect", "path": "player_greeting:text", "value": ""},

  {"cmd": "log", "message": "settings: the language row switches to German and back"},
  {"cmd": "action", "name": "nav_down"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "action", "name": "nav_down"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "game:focus", "value": 2},
  {"cmd": "action", "name": "confirm"},
  {"cmd": "wait", "frames": 4},
  {"cmd": "expect", "path": "settings_title:text", "value": "SETTINGS"},
  {"cmd": "expect", "path": "game:focus", "value": 0},
  {"cmd": "action", "name": "confirm"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "engine:locale", "value": "de"},
  {"cmd": "expect", "path": "settings_title:text", "value": "OPTIONEN"},
  {"cmd": "expect", "path": "settings_hint:text", "op": "contains", "value": "ÄNDERN"},
  {"cmd": "expect", "path": "loc:menu.play", "value": "SPIELEN"},
  {"cmd": "expect", "path": "best_1:text", "value": "NOCH NICHT GESPIELT"},
  {"cmd": "action", "name": "confirm"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "engine:locale", "value": "en"},
  {"cmd": "expect", "path": "settings_title:text", "value": "SETTINGS"},
  {"cmd": "expect", "path": "best_1:text", "value": "NOT PLAYED"},
  {"cmd": "action", "name": "back"},
  {"cmd": "wait", "frames": 4},
  {"cmd": "expect", "path": "settings_title:exists", "value": false},
  {"cmd": "expect", "path": "game:focus", "value": 0},

  {"cmd": "log", "message": "the first part is played on a virtual Xbox pad"},
  {"cmd": "gamepad", "action": "connect", "type": "xboxone"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "gamepad", "action": "tap", "button": "a"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "game:state", "value": "loading"},
  {"cmd": "wait_until", "path": "engine:scene", "value": "loading", "timeout_frames": 120},
  {"cmd": "wait_until", "path": "game:state", "value": "playing", "timeout_frames": 600},
  {"cmd": "wait", "frames": 5},
  {"cmd": "expect", "path": "engine:scene", "value": "level1"},
  {"cmd": "expect", "path": "game:crates_total", "value": 6},
  {"cmd": "expect", "path": "game:score", "value": 0},
  {"cmd": "expect", "path": "game:time_left", "op": ">", "value": 59},
  {"cmd": "expect", "path": "game:colliders", "op": ">=", "value": 10},
  {"cmd": "expect", "path": "*/player:position", "value": [0, 1, 5]},
  {"cmd": "expect", "path": "game:anim_state", "value": "idle"},
  {"cmd": "expect", "path": "jump_glyph:position.x", "value": 0},
  {"cmd": "set", "path": "engine:locale", "value": "de"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "level_title:text", "value": "Wieseninsel"},
  {"cmd": "expect", "path": "jump_glyph:position.x", "op": "<", "value": -40},
  {"cmd": "set", "path": "engine:locale", "value": "en"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "level_title:text", "value": "Meadow Isle"},
  {"cmd": "expect", "path": "jump_glyph:position.x", "value": 0},

  {"cmd": "log", "message": "stick up to the first crate"},
  {"cmd": "gamepad", "action": "axis", "axis": "lefty", "value": -1},
  {"cmd": "wait", "frames": 6},
  {"cmd": "expect", "path": "game:anim_state", "value": "run"},
  {"cmd": "wait_until", "path": "*/player:position.z", "op": "<=", "value": 3.1, "timeout_frames": 120},
  {"cmd": "gamepad", "action": "axis", "axis": "lefty", "value": 0},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "game:crates", "value": 1},
  {"cmd": "expect", "path": "game:score", "value": 10},

  {"cmd": "log", "message": "stick left, then up to the second crate"},
  {"cmd": "gamepad", "action": "axis", "axis": "leftx", "value": -1},
  {"cmd": "wait_until", "path": "*/player:position.x", "op": "<=", "value": -4.1, "timeout_frames": 180},
  {"cmd": "gamepad", "action": "axis", "axis": "leftx", "value": 0},
  {"cmd": "gamepad", "action": "axis", "axis": "lefty", "value": -1},
  {"cmd": "wait_until", "path": "*/player:position.z", "op": "<=", "value": 0.9, "timeout_frames": 120},
  {"cmd": "gamepad", "action": "axis", "axis": "lefty", "value": 0},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "game:crates", "value": 2},

  {"cmd": "log", "message": "pause and resume with the pad's Menu button"},
  {"cmd": "gamepad", "action": "tap", "button": "start"},
  {"cmd": "wait", "frames": 3},
  {"cmd": "expect", "path": "game:state", "value": "paused"},
  {"cmd": "expect", "path": "engine:scene", "value": "level1"},
  {"cmd": "expect", "path": "resume_button:visible", "value": true},
  {"cmd": "expect", "path": "game:speed", "value": 0},
  {"cmd": "expect", "path": "game:sfx_paused", "value": true},
  {"cmd": "wait", "frames": 20},
  {"cmd": "log", "message": "game time stands still, the pause panel's tween runs on the unscaled clock"},
  {"cmd": "expect", "path": "pause_panel:scale", "value": [1, 1]},
  {"cmd": "gamepad", "action": "tap", "button": "a"},
  {"cmd": "wait", "frames": 3},
  {"cmd": "expect", "path": "game:state", "value": "playing"},
  {"cmd": "expect", "path": "game:speed", "value": 1},
  {"cmd": "expect", "path": "game:sfx_paused", "value": false},

  {"cmd": "log", "message": "keyboard from here: up to the third crate"},
  {"cmd": "key", "key": "W", "action": "down"},
  {"cmd": "wait_until", "path": "*/player:position.z", "op": "<=", "value": -3.0, "timeout_frames": 180},
  {"cmd": "key", "key": "W", "action": "up"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "game:crates", "value": 3},

  {"cmd": "log", "message": "right, jump onto the hill, the crate on top"},
  {"cmd": "key", "key": "D", "action": "down"},
  {"cmd": "wait_until", "path": "*/player:position.x", "op": ">=", "value": -1.9, "timeout_frames": 120},
  {"cmd": "key", "key": "Space", "action": "tap", "frames": 2},
  {"cmd": "wait", "frames": 4},
  {"cmd": "expect", "path": "game:anim_state", "value": "jump"},
  {"cmd": "wait_until", "path": "*/player:position.x", "op": ">=", "value": 0.1, "timeout_frames": 120},
  {"cmd": "expect", "path": "*/player:position.y", "op": ">=", "value": 1.99},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "game:crates", "value": 4},

  {"cmd": "log", "message": "off the hill to the right, down to the fifth crate"},
  {"cmd": "wait_until", "path": "*/player:position.x", "op": ">=", "value": 4.0, "timeout_frames": 120},
  {"cmd": "key", "key": "D", "action": "up"},
  {"cmd": "key", "key": "S", "action": "down"},
  {"cmd": "wait_until", "path": "*/player:position.z", "op": ">=", "value": -1.3, "timeout_frames": 120},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "game:crates", "value": 5},
  {"cmd": "expect", "path": "*/player:position.y", "value": 1},

  {"cmd": "log", "message": "down past the spikes to the last crate"},
  {"cmd": "wait_until", "path": "game:crates", "value": 6, "timeout_frames": 180},
  {"cmd": "key", "key": "S", "action": "up"},
  {"cmd": "expect", "path": "game:state", "value": "level_end"},
  {"cmd": "expect", "path": "game:score", "value": 60},
  {"cmd": "expect", "path": "game:hits", "value": 0},
  {"cmd": "expect", "path": "game:falls", "value": 0},
  {"cmd": "expect", "path": "game:time_left", "op": ">", "value": 40},
  {"cmd": "expect", "path": "*/player:position.x", "op": ">", "value": 3.3},
  {"cmd": "expect", "path": "*/player:position.x", "op": "<", "value": 4.7},
  {"cmd": "expect", "path": "*/player:position.z", "op": ">", "value": 3.9},
  {"cmd": "expect", "path": "*/player:position.z", "op": "<", "value": 5.5},

  {"cmd": "log", "message": "results"},
  {"cmd": "wait_until", "path": "engine:scene", "value": "results", "timeout_frames": 300},
  {"cmd": "wait", "frames": 60},
  {"cmd": "expect", "path": "game:state", "value": "results"},
  {"cmd": "expect", "path": "game:result_stars", "value": 3},
  {"cmd": "expect", "path": "game:result_score", "op": ">", "value": 260},
  {"cmd": "expect", "path": "result_title:text", "value": "LEVEL CLEAR!"},
  {"cmd": "expect", "path": "result_crates:text", "value": "6 / 6"},
  {"cmd": "expect", "path": "next_button:visible", "value": true},

  {"cmd": "log", "message": "name entry: at most 12 characters, kept on Enter"},
  {"cmd": "expect", "path": "player_name:text", "value": ""},
  {"cmd": "type", "label": "player_name", "text": "Ada Lovelace-Byron"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "player_name:text", "value": "Ada Lovelace"},
  {"cmd": "expect", "path": "game:player_name", "value": ""},
  {"cmd": "key", "key": "Return", "action": "tap"},
  {"cmd": "wait", "frames": 3},
  {"cmd": "expect", "path": "game:player_name", "value": "Ada Lovelace"},
  {"cmd": "expect", "path": "game:state", "value": "results"},
  {"cmd": "expect", "path": "game:focus", "value": 0},

  {"cmd": "log", "message": "back to the menu"},
  {"cmd": "action", "name": "nav_right"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "action", "name": "nav_right"},
  {"cmd": "wait", "frames": 2},
  {"cmd": "expect", "path": "game:focus", "value": 2},
  {"cmd": "action", "name": "confirm"},
  {"cmd": "wait_until", "path": "engine:scene", "value": "menu", "timeout_frames": 300},
  {"cmd": "wait", "frames": 10},
  {"cmd": "expect", "path": "game:state", "value": "menu"},
  {"cmd": "expect", "path": "game:levels_completed", "value": 1},
  {"cmd": "wait_until", "path": "player_greeting:text", "value": "HELLO, Ada Lovelace!", "timeout_frames": 120},
  {"cmd": "quit"}
]
